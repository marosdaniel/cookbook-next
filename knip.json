{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/{page,layout,loading,error,not-found,route,template,default}.{ts,tsx}",
    "src/proxy.ts",
    "prisma/seed.ts",
    "scripts/**/*.{js,mjs,ts}"
  ],
  "project": [
    "src/**/*.{ts,tsx}",
    "prisma/**/*.ts",
    "scripts/**/*.{js,mjs,ts}"
  ],
  "ignore": ["src/lib/graphql/generated/**"],
  "ignoreDependencies": [
    "@graphql-codegen/*",
    "@semantic-release/*",
    "baseline-browser-mapping",
    "dotenv",
    "fast-uri",
    "find-my-way",
    "happy-dom",
    "sharp"
  ]
}
